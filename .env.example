# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요. (.env는 git에 커밋되지 않음)
#   cp .env.example .env

# DataGSM OAuth (필수)
DATAGSM_CLIENT_ID=774e66a4-0115-44b4-9637-a65b798f7b6e
DATAGSM_CLIENT_SECRET=여기에-시크릿
# 로컬 개발용. 운영 배포 시엔 이 줄을 지우면 기본값(https://gsmhs.xyz/oauth/callback)이 쓰임
DATAGSM_REDIRECT_URI=http://localhost:8080/oauth/callback

# Cloudflare DNS 연동 (선택 — 비워두면 DNS 없이 로컬 모드로 동작)
CF_API_TOKEN=
CF_ZONE_ID=

# 관리자로 취급할 DataGSM 계정 이메일 (쉼표로 여러 명 지정 가능)
ADMIN_EMAILS=

# SQLite DB 파일 경로 (선택, 기본값 gsmhs.db)
#GSMHS_DB_PATH=gsmhs.db
